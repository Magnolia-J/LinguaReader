# LinguaReader Workspace · LLM 配置
# 复制本文件为 .env 并填入真实值（.env 不会被提交）。
# 不填 LLM_API_KEY 时，AI 使用内置演示骨架；填了则启用真实分析与全文批注。
#
# 注意：自 v 开源模板起，LLM 也可以在界面里配置——
#   桌面端「☁ 云同步」弹窗 → 「🔑 配置你自己的 AI 模型」填写并保存即可，
#   配置存在本机浏览器（localStorage），不进仓库，别人下载后用他们自己的密钥。
# 界面配置优先；本 .env 仅作为「未填界面」时的兜底。两者都不填则走演示骨架。

# 必填：API Key（任意 OpenAI 兼容接口）
LLM_API_KEY=

# 接口地址（末尾不要带 /）
# 常见可选值：
#   OpenAI:        https://api.openai.com/v1
#   DeepSeek:      https://api.deepseek.com/v1
#   通义千问:       https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM:       https://open.bigmodel.cn/api/paas/v4
#   腾讯混元:       https://api.hunyuan.cloud.tencent.com/v1
LLM_API_BASE=https://api.openai.com/v1

# 模型名（按各家文档填写）
LLM_MODEL=gpt-4o-mini

# 可选
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1400

# 后端服务端口
PORT=3007
