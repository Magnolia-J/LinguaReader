# =========================================================
# LinguaReader Workspace · 环境变量模板
# ---------------------------------------------------------
# 用法：复制本文件为 .env 并填入你自己的值（.env 已被 .gitignore 排除，不会提交）。
# 所有密钥都来自你自己的账号，本项目不内置任何人的配置。
# =========================================================

# ─────────────────────────────────────────────────────────
# 一、LLM / AI 精读助手（服务端代理，推荐配置）
#     支持任意 OpenAI 兼容接口：OpenAI / OpenRouter / DeepSeek /
#     SiliconFlow / Gemini(兼容接口) / 通义 / 智谱 / 腾讯混元 等。
#     下面两组变量二选一即可（同名优先用 LLM_*）。
# ─────────────────────────────────────────────────────────

# 方式 A：本项目约定变量名
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 方式 B：通用变量名（与很多教程一致，效果同上）
# OPENAI_API_KEY=
# API_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# 可选微调
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1400

# ─────────────────────────────────────────────────────────
# 二、Supabase（可选：云端同步 / 服务端备份）
#     在 https://supabase.com 免费注册并新建项目后获取。
#     前端（浏览器）用的 anon key 是「公开安全」的，安全由行级安全 RLS 保证；
#     但本项目默认让用户在界面里自行填写，避免连到别人的项目。
# ─────────────────────────────────────────────────────────

# 前端 / 静态托管用（如部署到 Vercel/Netlify/Cloudflare 想预置默认值，可选）
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=

# 服务端云备份用（仅服务端，切勿泄露；建议放在环境变量而非文件）
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE=<service_role 密钥，拥有超级权限，只在服务端使用>

# ─────────────────────────────────────────────────────────
# 三、服务端口
# ─────────────────────────────────────────────────────────
PORT=3007
